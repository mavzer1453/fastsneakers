<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>{{ shop.name }}</title><style>
  @media only screen and (max-width: 480px) {
    .card { padding: 20px 14px 18px !important; border-radius: 14px !important; }
    .sp { padding: 16px 6px 12px !important; }
    .step-label { font-size: 8.5px !important; letter-spacing: 0 !important; }
    .node { width: 26px !important; height: 26px !important; line-height: 26px !important; font-size: 12px !important; }
    .h1 { font-size: 19px !important; }
    .item-title { font-size: 13px !important; }
    .item-price { font-size: 13px !important; }
  }
</style></head>
<body style="margin:0;padding:0;background:#ffffff;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background:#ffffff;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;">
  <tr><td align="center" style="padding:0 0 16px;">
    <img src="https://cdn.shopify.com/s/files/1/1024/9466/7139/files/vespera-collectives-logo.png?v=1786885935" width="110" alt="Vespera Collectives" style="display:block;width:110px;height:auto;border:0;">
  </td></tr>
  <tr><td class="card" style="background:#ffffff;border:1px solid #e3e3e6;border-radius:18px;padding:30px 30px 26px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#16181d;"><div style="font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#d9b968;padding-bottom:10px;">Delivered</div><div class="h1" style="font-size:22px;font-weight:800;letter-spacing:-.01em;padding-bottom:6px;">Enjoy{% if customer.first_name %}, {{ customer.first_name }}{% endif %} &mdash; it&rsquo;s yours.</div><div style="font-size:14px;color:#6b6b70;line-height:1.6;padding-bottom:20px;">Order {{ order_name }} has been delivered. Every piece was verified authentic before it shipped &mdash; time to wear it.</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e3e3e6;border-radius:14px;background:#ffffff;">
<tr><td class="sp" style="padding:20px 12px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;"><col style="width:15%"><col style="width:13.3%"><col style="width:15%"><col style="width:13.3%"><col style="width:15%"><col style="width:13.3%"><col style="width:15%"><tr><td align="center" valign="top" style="padding:0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;"><tr><td class="node" align="center" valign="middle" width="32" height="32" bgcolor="#16181d" style="width:32px;height:32px;border-radius:999px;background:#16181d;color:#ffffff;font-size:14px;font-weight:700;line-height:32px;">&#10003;</td></tr></table>
<div class="step-label" style="font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.02em;color:#16181d;padding-top:7px;">Ordered</div>
</td><td valign="top" style="padding:15px 3px 0;"><div style="border-top:3px solid #16181d;height:0;line-height:0;font-size:0;">&#8203;</div></td><td align="center" valign="top" style="padding:0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;"><tr><td class="node" align="center" valign="middle" width="32" height="32" bgcolor="#16181d" style="width:32px;height:32px;border-radius:999px;background:#16181d;color:#ffffff;font-size:14px;font-weight:700;line-height:32px;">&#10003;</td></tr></table>
<div class="step-label" style="font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.02em;color:#16181d;padding-top:7px;">Processing</div>
</td><td valign="top" style="padding:15px 3px 0;"><div style="border-top:3px solid #16181d;height:0;line-height:0;font-size:0;">&#8203;</div></td><td align="center" valign="top" style="padding:0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;"><tr><td class="node" align="center" valign="middle" width="32" height="32" bgcolor="#16181d" style="width:32px;height:32px;border-radius:999px;background:#16181d;color:#ffffff;font-size:14px;font-weight:700;line-height:32px;">&#10003;</td></tr></table>
<div class="step-label" style="font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.02em;color:#16181d;padding-top:7px;">Shipped</div>
</td><td valign="top" style="padding:15px 3px 0;"><div style="border-top:3px solid #16181d;height:0;line-height:0;font-size:0;">&#8203;</div></td><td align="center" valign="top" style="padding:0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;"><tr><td class="node" align="center" valign="middle" width="32" height="32" bgcolor="#16181d" style="width:32px;height:32px;border-radius:999px;background:#16181d;color:#ffffff;font-size:14px;font-weight:700;line-height:32px;">&#10003;</td></tr></table>
<div class="step-label" style="font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.02em;color:#16181d;padding-top:7px;">Delivered</div>
</td></tr></table>
</td></tr></table><div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#6b6b70;padding:26px 0 6px;">Your items</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{% for line in subtotal_line_items %}
  <tr>
    <td width="64" valign="middle" style="padding:12px 12px 12px 0;">
      {% if line.image %}<img src="{{ line.image | image_url: width: 128 }}" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border-radius:8px;border:1px solid #e3e3e6;background:#f7f7f8;">{% endif %}
    </td>
    <td valign="middle" style="padding:12px 10px 12px 0;">
      <div class="item-title" style="font-size:14px;font-weight:600;line-height:1.4;color:#16181d;">{{ line.title }}</div>
      <div style="font-size:12px;color:#6b6b70;padding-top:3px;">{{ line.final_price | money }} &times; {{ line.quantity }}</div>
      <div style="font-size:12px;color:#6b6b70;padding-top:2px;">{% if line.variant.title != blank and line.variant.title != 'Default Title' %}{{ line.variant.title }}{% if line.sku != blank %} &middot; {% endif %}{% endif %}{% if line.sku != blank %}SKU {{ line.sku }}{% endif %}</div>
    </td>
    <td class="item-price" valign="middle" align="right" style="padding:12px 0;font-size:14px;font-weight:700;white-space:nowrap;color:#16181d;">{{ line.final_line_price | money }}</td>
  </tr>
  {% unless forloop.last %}<tr><td colspan="3" height="1" style="height:1px;line-height:1px;font-size:0;background:#efeff1;">&#8203;</td></tr>{% endunless %}
{% endfor %}
</table><div style="font-size:13px;color:#6b6b70;line-height:1.6;padding-top:18px;">Something not right? You have 14 days to return unworn items with their tags &mdash; contact <a href="mailto:{{ shop.email }}" style="color:#16181d;">{{ shop.email }}</a>.</div><table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:24px auto 4px;"><tr>
  <td align="center" bgcolor="#16181d" style="border-radius:999px;">
    <a href="{{ order_status_url }}" target="_blank" style="display:inline-block;padding:14px 36px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px;">View your order</a>
  </td>
</tr></table>  </td></tr>
  <tr><td align="center" style="padding:20px 20px 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <div style="font-size:13px;font-weight:800;letter-spacing:.02em;color:#16181d;">Vespera Collectives</div>
    <div style="font-size:12px;color:#6b6b70;padding-top:5px;">Curated streetwear, sneakers &amp; essentials &mdash; verified authentic before it ships.</div>
    <div style="font-size:12px;color:#6b6b70;padding-top:8px;">Questions? <a href="mailto:{{ shop.email }}" style="color:#16181d;">{{ shop.email }}</a></div>
    <div style="font-size:11px;color:#9a9aa2;padding-top:12px;">You&rsquo;re receiving this email about your order {{ order_name }} at Vespera Collectives.</div>
  </td></tr>
</table>
</td></tr></table>
</body></html>